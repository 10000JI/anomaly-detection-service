# ========================================
# Kafka Configuration
# ========================================
# Kafka 클러스터 연결 정보
KAFKA_BOOTSTRAP_SERVERS=192.168.150.115:9092,192.168.150.120:9092,192.168.150.125:9092
KAFKA_TOPIC=user-events-topic
KAFKA_CONSUMER_GROUP=recommendation-engine-group
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_ENABLE_AUTO_COMMIT=false

# ========================================
# MySQL Configuration
# ========================================
# MySQL 데이터베이스 연결 정보
MYSQL_HOST=192.168.150.110
MYSQL_PORT=3306
MYSQL_USER=didim
MYSQL_PASSWORD=fpemdnemzpdl123$
MYSQL_DATABASE=cursor_practice
MYSQL_POOL_SIZE=5
MYSQL_POOL_NAME=recommendation_pool

# ========================================
# Redis Configuration
# ========================================
# Redis 캐시 서버 연결 정보
REDIS_HOST=192.168.150.115
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=fpemdnemzpdl123$
REDIS_TTL=600

# ========================================
# Prometheus Configuration
# ========================================
# Prometheus 서버 연결 정보
PROMETHEUS_HOST=192.168.150.110
PROMETHEUS_PORT=19090

# ========================================
# PySpark Configuration
# ========================================
# PySpark 로컬 실행 설정
SPARK_APP_NAME=RecommendationSystem
SPARK_MASTER=local[*]
SPARK_EXECUTOR_MEMORY=2g
SPARK_DRIVER_MEMORY=1g
SPARK_LOG_LEVEL=WARN

# ========================================
# API Configuration
# ========================================
# REST API 서버 설정
API_HOST=localhost
API_PORT=8000
API_DEBUG=true

# ========================================
# Logging Configuration
# ========================================
# 로깅 레벨 설정
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
